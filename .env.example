# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Registration (set to "false" in production)
ALLOW_PUBLIC_REGISTRATION="false"

# MFA — optional by default; set to "true" to require MFA for manager/owner roles at login
ENFORCE_MFA_FOR_PRIVILEGED="false"

# Data retention cron (Vercel Cron: weekly Sunday 03:00 UTC)
CRON_SECRET="generate-a-long-random-secret"
RETENTION_ACTIVITY_LOG_DAYS="730"
RETENTION_DISABLED_PATIENT_DAYS="730"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Upload station (clinic photo kiosk)
UPLOAD_STATION_PIN="your-pin"
UPLOAD_STATION_SECRET="generate-a-long-random-secret"
# Required when multiple organizations exist; optional for single-clinic deployments
UPLOAD_STATION_ORGANIZATION_ID=""

# Email (optional)
EMAIL_FROM="info@example.com"
SUPPORT_EMAIL="support@example.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# External APIs (optional — enable only the features you use)
GOOGLE_API_KEY=""
GOOGLE_CX=""
OPENFDA_API_KEY=""
OPENROUTE_API_KEY=""
HUGGINGFACE_API_KEY=""
REPLICATE_API_TOKEN=""
NEXT_PUBLIC_YOUTUBE_API_KEY=""

# Support widget (optional)
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
NEXT_PUBLIC_SUPPORT_HOURS_NL=""
NEXT_PUBLIC_SUPPORT_HOURS_RO=""

# Local file storage (optional)
ARCA_DATA_DIR=""
ARCA_UPLOADS_DIR=""
